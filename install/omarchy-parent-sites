# Omarchy kids mode: website list for the kid account.
# Nothing is blocked until a parent uncomments (or adds) names below.
# sudo omarchy-parent sites edit opens this file and applies on save;
# sites block|allow|list also edit it. A hand edit takes effect at the next apply.
#
# Blocklist (default) sinkholes listed domains in /etc/hosts and blocks them
# in Chromium-family / Firefox policy. Allowlist is browser-only: everything
# else is blocked in those browsers, and /etc/hosts is left alone. Neither
# mode stops a raw IP, a portable browser, or a live USB with the disk password.
#
# mode: blocklist
# youtube.com
# tiktok.com
#
# mode: allowlist
# khanacademy.org
# scratch.mit.edu
# wikipedia.org
