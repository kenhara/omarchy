#!/bin/bash

# omarchy:summary=Ensure default application launchers and mise wrappers are installed.

# Copy .desktop declarations
mkdir -p ~/.local/share/applications
cp "$OMARCHY_PATH"/applications/*.desktop ~/.local/share/applications/

# Skel already planted the adult set. On a child install, copy any extra
# launchers from install/omarchy-child-applications and drop the names in
# omarchy-child-hidden-applications. Parent overrides in
# /etc/omarchy/parent-apps-show and parent-apps-hide survive refresh and
# updates; show wins.
if omarchy-profile-child; then
  child_apps="$OMARCHY_PATH/install/omarchy-child-applications"
  if [[ -d $child_apps ]]; then
    cp "$child_apps"/*.desktop ~/.local/share/applications/
  fi
  source "$OMARCHY_PATH/install/helpers/parent-apps.sh"
  parent_apps_refresh_home "$HOME"
fi

if omarchy-cmd-present alacritty; then
  cp "$OMARCHY_PATH/default/alacritty/Alacritty.desktop" ~/.local/share/applications/
fi

if [[ -f "$OMARCHY_PATH/install/user/mise.sh" ]]; then
  bash "$OMARCHY_PATH/install/user/mise.sh"
fi

update-desktop-database ~/.local/share/applications
