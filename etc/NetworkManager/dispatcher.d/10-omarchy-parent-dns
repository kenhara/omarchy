#!/bin/bash
# Re-apply family DNS on the connection that just came up on a locked child
# install, so a new school or hotel profile cannot keep DHCP nameservers.
# One connection, one device: no resolved rewrite, no browser policy, no
# parent.conf write. `reapply` is ignored so a fix cannot retrigger itself.

case "${2:-}" in
  up|dhcp4-change|dhcp6-change) ;;
  *) exit 0 ;;
esac

[[ -n ${CONNECTION_UUID:-} ]] || exit 0

omarchy-profile-child || exit 0
omarchy-parent-dns locked || exit 0

exec 9>"${OMARCHY_PARENT_DNS_LOCK:-/run/omarchy-parent-dns.lock}"
flock -n 9 || exit 0
exec omarchy-parent-dns fix-connection "$CONNECTION_UUID" "${DEVICE_IFACE:-$1}"
