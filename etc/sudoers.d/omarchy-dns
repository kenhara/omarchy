# Switching between the stock providers is a one-click toggle in the network
# panel, so it must not stop for a password. Custom is deliberately absent: it
# points the machine at servers the caller supplies, and it already runs in a
# terminal that can ask. Families and Security are granted to %wheel so adults
# get the same one-click as Cloudflare and Google. The kid is outside wheel,
# so the child lock is unchanged.
%wheel ALL=(root) NOPASSWD: /usr/bin/omarchy-dns Cloudflare, /usr/bin/omarchy-dns Families, /usr/bin/omarchy-dns Security, /usr/bin/omarchy-dns Google, /usr/bin/omarchy-dns DHCP
